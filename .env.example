# Optional LLM provider
COPILOT_LLM_PROVIDER=
COPILOT_LLM_MODEL=
COPILOT_LLM_BASE_URL=
COPILOT_LLM_API_KEY=

# v0.4 read-only integrations
COPILOT_AIRFLOW_URL=
COPILOT_AIRFLOW_TOKEN=
COPILOT_GITLAB_URL=
COPILOT_GITLAB_TOKEN=

# Kubernetes uses the local kubectl context and is restricted to read-only commands.
# Database adapters are registered programmatically with a DB-API connection factory.
